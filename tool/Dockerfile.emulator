# Android emulator (KVM) on top of the Flutter image, for `make test-android-bench`.
ARG BASE=luks-unlocker-flutter
FROM ${BASE}

ARG SYSTEM_IMAGE="system-images;android-35;default;x86_64"

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpulse0 \
 && rm -rf /var/lib/apt/lists/* \
 && install -d -o dev /opt/android-avd

USER dev
# Outside HOME, which is a volume at run time.
ENV ANDROID_AVD_HOME=/opt/android-avd

RUN yes | sdkmanager "${SYSTEM_IMAGE}" >/dev/null \
 && echo no | avdmanager create avd -n bench -k "${SYSTEM_IMAGE}" -d pixel_6 >/dev/null

ENV PATH=/opt/android-sdk/emulator:${PATH}

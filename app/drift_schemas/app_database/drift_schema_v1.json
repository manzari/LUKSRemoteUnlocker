    {
      "name": "vault_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vault_records\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"nonce\" BLOB NOT NULL, \"ciphertext\" BLOB NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ssh_keys",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ssh_keys\" (\"id\" TEXT NOT NULL, \"label\" TEXT NOT NULL, \"key_type\" TEXT NOT NULL, \"bits\" INTEGER NOT NULL, \"public_line\" TEXT NOT NULL, \"fingerprint\" TEXT NOT NULL UNIQUE, \"vault_record_id\" TEXT NOT NULL REFERENCES vault_records (id), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "secrets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"secrets\" (\"id\" TEXT NOT NULL, \"label\" TEXT NOT NULL, \"vault_record_id\" TEXT NOT NULL REFERENCES vault_records (id), \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"built_in\" INTEGER NOT NULL CHECK (\"built_in\" IN (0, 1)), \"driver\" TEXT NOT NULL, \"command\" TEXT NOT NULL, \"prompt_regex\" TEXT NULL, \"success_regex\" TEXT NULL, \"failure_regex\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "hosts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"hosts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"group_name\" TEXT NULL, \"preboot_json\" TEXT NOT NULL, \"login_user\" TEXT NOT NULL, \"key_id\" TEXT NULL REFERENCES ssh_keys (id), \"secret_id\" TEXT NULL REFERENCES secrets (id), \"disk_overrides_json\" TEXT NOT NULL DEFAULT '{}', \"profile_id\" TEXT NULL REFERENCES profiles (id), \"postboot_host\" TEXT NULL, \"postboot_port\" INTEGER NOT NULL, \"postboot_check\" TEXT NOT NULL, \"wait_timeout_seconds\" INTEGER NOT NULL, \"boot_timeout_seconds\" INTEGER NOT NULL, \"preboot_key_json\" TEXT NULL, \"postboot_key_json\" TEXT NULL, \"legacy_algorithms\" INTEGER NOT NULL CHECK (\"legacy_algorithms\" IN (0, 1)), \"enabled\" INTEGER NOT NULL CHECK (\"enabled\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "vault_password_slot",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vault_password_slot\" (\"id\" INTEGER NOT NULL, \"salt\" BLOB NOT NULL, \"memory_kib\" INTEGER NOT NULL, \"iterations\" INTEGER NOT NULL, \"parallelism\" INTEGER NOT NULL, \"nonce\" BLOB NOT NULL, \"wrapped_key\" BLOB NOT NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "vault_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vault_metadata\" (\"id\" INTEGER NOT NULL, \"format_version\" INTEGER NOT NULL, \"vault_id\" TEXT NOT NULL, \"key_check_nonce\" BLOB NOT NULL, \"key_check\" BLOB NOT NULL, \"biometric_slot_enrolled\" INTEGER NOT NULL CHECK (\"biometric_slot_enrolled\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "runs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"runs\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"finished_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "run_hosts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"run_hosts\" (\"run_id\" TEXT NOT NULL REFERENCES runs (id) ON DELETE CASCADE, \"host_id\" TEXT NOT NULL, \"host_name\" TEXT NOT NULL, \"final_state\" TEXT NULL, PRIMARY KEY (\"run_id\", \"host_id\"));"
        }

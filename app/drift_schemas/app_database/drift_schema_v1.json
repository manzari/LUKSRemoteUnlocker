          "sql": "CREATE TABLE IF NOT EXISTS \"run_events\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"run_id\" TEXT NOT NULL REFERENCES runs (id) ON DELETE CASCADE, \"host_id\" TEXT NOT NULL, \"time\" INTEGER NOT NULL, \"phase\" TEXT NOT NULL, \"message\" TEXT NOT NULL, \"result\" TEXT NULL);"
